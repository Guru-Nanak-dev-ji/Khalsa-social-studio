<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deliberately no Internet, contacts, storage, microphone or clipboard permissions. -->
    <application android:allowBackup="false" android:label="KDN ਪੰਜਾਬੀ Keyboard"
        android:icon="@drawable/ic_keyboard" android:supportsRtl="true"
        android:theme="@style/AppTheme" android:usesCleartextTraffic="false">
        <activity android:name=".SetupActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".PunjabiKeyboardService" android:label="KDN ਪੰਜਾਬੀ Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
    </application>
</manifest>
